# Host process identity and timezone. The ONLY service settings that live
# here; every other setting comes from config/config.yaml (copy the
# config.example.yaml template). Do not commit real values.
PUID=1000
PGID=1000
TZ=Europe/Istanbul

# Host-side port mapping. The service itself binds 0.0.0.0 inside the
# container; keep the host address loopback (default) unless a reverse
# proxy or private network explicitly publishes the ports.
# TELEDRIVE_BIND_ADDRESS=0.0.0.0 exposes WebUI/S3 on the LAN — use only on
# trusted private networks.
TELEDRIVE_WEB_PORT=8080
TELEDRIVE_S3_PORT=9000
#TELEDRIVE_BIND_ADDRESS=127.0.0.1

# Extra database driver packages (e.g. oracledb) passed to the Docker image as
# a compose build arg and pip-installed at startup. Leave empty for the
# bundled SQLite/PostgreSQL/MySQL drivers.
#TELEDRIVE_DB_EXTRA_PACKAGES=
